          posthog.init('phc_qXCRY5er6TKcKA9Wa8B2DBNTpcLt7TYBd368mnqJjZLy', {
            api_host: 'https://eu.i.posthog.com',
            defaults: '2026-01-30',
            person_profiles: 'identified_only',
          });
          window.posthogInitDone = true;
        }
      };

      // Au chargement de la page, on vérifie si le consentement a déjà été donné
      if (typeof localStorage !== 'undefined' && localStorage.getItem('cookie-consent') === 'accepted') {
        window.initPostHog();
      }
    </script>
  </head>
  <body class="antialiased">
    <slot />
    <CookieBanner />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
