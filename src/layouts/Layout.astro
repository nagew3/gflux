---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GFlux | Automatisation IA pour ESN & Gain de Productivité",
  description = "GFlux aide les dirigeants d'ESN en France à automatiser leur gestion de mails et processus administratifs. Réservez votre audit gratuit et gagnez 5h par semaine."
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://gflux.fr/" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gflux.fr/" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content="https://gflux.fr/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" /></noscript>

    <!-- JSON-LD Breadcrumb / Organization / Service -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://gflux.fr/#organization",
            "name": "GFlux",
            "url": "https://gflux.fr",
            "description": "Automatisation IA sur mesure pour les dirigeants d'ESN."
          },
          {
            "@type": "Service",
            "name": "Automatisation et IA pour ESN",
            "provider": {"@id": "https://gflux.fr/#organization"},
            "description": "Système sur mesure d'automatisation des flux administratifs et emails pour ESN.",
            "areaServed": "FR"
          }
        ]
      }
    </script>
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
