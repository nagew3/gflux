---
const testimonials = [
  {
    quote: "En 3 semaines, j'ai récupéré mes lundis matin. Plus de tri de mails, plus d'oublis de relances — mes consultants sont staffés plus vite qu'avant.",
    name: "Laurent M.",
    role: "Fondateur & DG",
    company: "ESN · 25 collaborateurs",
    metric: "12h récupérées / semaine",
    avatar: "L",
    accentBg: "bg-accent-blue",
  },
  {
    quote: "Je ne pensais pas qu'une IA pouvait comprendre la logique de mon activité. GFlux a cartographié nos processus et maintenant, 80% de mes tâches admin sont pré-traitées. Je valide en un clic.",
    name: "Sophie D.",
    role: "Directrice des opérations",
    company: "ESN · 40 collaborateurs",
    metric: "Zéro facture oubliée depuis 4 mois",
    avatar: "S",
    accentBg: "bg-deep-blue",
  },
  {
    quote: "On hésitait à recruter une assistante de direction. GFlux nous fait économiser l'équivalent de ce salaire tout en étant disponible 24/7. Le ROI est immédiat.",
    name: "Marc-Antoine R.",
    role: "CEO",
    company: "ESN · 15 collaborateurs",
    metric: "2 200 € économisés / mois",
    avatar: "M",
    accentBg: "bg-accent-light",
  },
];
---

<section id="temoignages" class="section-padding bg-white">
  <div class="container-narrow">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal badge bg-violet-50 text-violet-600 border border-violet-100 mb-6">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
        Ce que disent nos clients
      </div>
      <h2 class="reveal font-display text-section text-deep-tech mb-5">
        Ils ont repris le <span class="text-accent-blue">contrôle de leur temps</span>
      </h2>
      <p class="reveal text-text-secondary text-lg">
        Des dirigeants d'ESN comme vous qui ont transformé leurs heures perdues en croissance.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((t, i) => (
        <div
          class="reveal group bg-surface/50 rounded-2xl p-6 md:p-8 border border-deep-tech/5 hover:border-accent-blue/20 hover:shadow-card transition-all duration-500 flex flex-col"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <!-- Stars -->
          <div class="flex gap-0.5 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-text-secondary leading-relaxed text-sm mb-6 flex-grow">
            "{t.quote}"
          </blockquote>

          <!-- Metric -->
          <div class="mb-5 py-2.5 px-4 rounded-xl bg-accent-blue/5 border border-accent-blue/10 text-center">
            <span class="text-sm font-bold text-accent-blue">{t.metric}</span>
          </div>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class={`w-10 h-10 rounded-full ${t.accentBg} flex items-center justify-center text-white font-display font-bold text-sm`}>
              {t.avatar}
            </div>
            <div>
              <p class="font-display font-bold text-deep-tech text-sm">{t.name}</p>
              <p class="text-text-muted text-xs">{t.role} · {t.company}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
