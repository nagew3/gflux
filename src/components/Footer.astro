---
const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-tech text-white/60">
  <div class="container-narrow py-12 md:py-16">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-accent-blue to-accent-light flex items-center justify-center">
          <span class="text-white font-display font-bold text-xs">G</span>
        </div>
        <span class="font-display font-bold text-base text-white">GFlux</span>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6 text-sm">
        <a href="#hero" class="hover:text-white transition-colors duration-200">Accueil</a>
        <a href="#solution" class="hover:text-white transition-colors duration-200">Solution</a>
        <a href="#temoignages" class="hover:text-white transition-colors duration-200">Témoignages</a>
        <a href="#offre" class="hover:text-white transition-colors duration-200">Offre</a>
      </div>

      <!-- Legal Links -->
      <div class="flex items-center gap-4 text-xs">
        <a href="#mentions-legales" class="hover:text-white transition-colors duration-200">Mentions légales</a>
        <span class="text-white/20">|</span>
        <a href="#confidentialite" class="hover:text-white transition-colors duration-200">Politique de confidentialité</a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-6 border-t border-white/10 text-center">
      <p class="text-xs">
        © {currentYear} GFlux. Tous droits réservés.
      </p>
    </div>
  </div>
</footer>
