---
const calendlyUrl = "https://calendly.com/gawen-francois/audit-perte-de-temps-gflux";
---

<section id="hero" class="relative min-h-screen flex items-center pt-32 pb-20 bg-black overflow-x-hidden font-sans border-b border-bento-border">
  
  <div class="container-narrow w-full relative z-10 flex flex-col items-center mt-10">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Badge -->
      <div class="reveal flex items-center justify-center bg-deep-navy/40 border border-tech-blue/30 rounded-full pl-2 pr-4 py-1.5 text-tech-blue text-xs sm:text-sm mb-10 tracking-wider font-light mx-auto max-w-max shadow-[0_0_20px_rgba(27,127,248,0.2)]">
        <span class="bg-tech-blue text-white px-3 py-1 rounded-full mr-3 text-xs font-semibold">CONFIDENTIALITÉ GARANTIE</span>
        Architecture IA 100% Sécurisée
      </div>

      <!-- Headline (Quantam style: huge, thin) -->
      <h1 class="reveal text-5xl sm:text-6xl md:text-[5rem] lg:text-[6rem] font-bold leading-tight font-light text-white mb-2" style="transition-delay: 0.1s">
        Risque zéro.
      </h1>
      <h1 class="reveal text-5xl sm:text-6xl md:text-[5rem] lg:text-[6rem] font-bold leading-tight mb-8 font-light text-transparent bg-clip-text bg-gradient-to-r from-tech-blue to-white" style="transition-delay: 0.2s">
        Résultat maximum.
      </h1>

      <!-- Sub-headline -->
      <p class="reveal text-base sm:text-lg text-text-secondary max-w-2xl mx-auto mb-2 font-light" style="transition-delay: 0.3s">
        Nous concevons vos agents IA de façon ultra-privatisée.
      </p>
      <p class="reveal text-sm sm:text-base text-blue-200 max-w-2xl mx-auto mb-14 font-light" style="transition-delay: 0.4s">
        Éradiquez votre charge administrative sans sacrifier la sécurité de vos données.
      </p>

      <!-- CTA & Trust -->
      <div class="reveal flex flex-col items-center justify-center gap-4 mb-24" style="transition-delay: 0.5s">
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="bg-tech-blue text-white border border-tech-blue px-8 py-3.5 cursor-pointer hover:bg-blue-600 transition-colors rounded-md text-base font-semibold shadow-[0_4px_30px_rgba(27,127,248,0.4)]">
            Démarrer 15min de diagnostic (Gratuit)
          </a>
          <a href="#solution" class="bg-white/5 border border-white/10 text-white px-8 py-3.5 cursor-pointer hover:bg-deep-navy/50 transition-colors rounded-md text-base font-light">
            Découvrir vos futurs agents
          </a>
        </div>
        <div class="flex items-center gap-2 mt-2 text-xs text-text-muted">
          <svg class="w-4 h-4 text-mustard" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          <span class="font-medium text-text-secondary">Sans engagement — Données stockées en France.</span>
        </div>
      </div>
      
      <!-- Infinite Moving Fading Carousel (Marquee) -->
      <div class="reveal w-full max-w-4xl mx-auto overflow-hidden relative h-16 z-10" style="transition-delay: 0.6s">
        <div class="flex animate-marquee whitespace-nowrap text-deep-navy font-display font-bold text-3xl sm:text-4xl tracking-widest items-center pt-2">
          <span class="mx-8">SÉCURITÉ INFAILLIBLE</span>
          <span class="mx-8">∞</span>
          <span class="mx-8">RÉSULTATS GARANTIS</span>
          <span class="mx-8">∞</span>
          <span class="mx-8">CONFIDENTIALITÉ</span>
          <span class="mx-8">∞</span>
          <span class="mx-8">SÉCURITÉ INFAILLIBLE</span>
          <span class="mx-8">∞</span>
          <span class="mx-8">RÉSULTATS GARANTIS</span>
          <span class="mx-8">∞</span>
          <span class="mx-8">CONFIDENTIALITÉ</span>
          <span class="mx-8">∞</span>
          <span class="mx-8">RÉSULTATS GARANTIS</span>
        </div>
        <!-- Fading gradients -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-black to-transparent"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-black to-transparent"></div>
      </div>
    </div>
  </div>

  <!-- Gradient Glow Footer / Hero Base -->
  <div class="absolute bottom-[-100px] left-0 right-0 h-[500px] bg-gradient-to-t from-deep-navy via-tech-blue/10 to-transparent rounded-t-full opacity-60 blur-3xl pointer-events-none"></div>

</section>
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-muted">
    <span class="text-xs tracking-widest uppercase">Découvrir</span>
    <div class="w-5 h-8 rounded-full border-2 border-text-muted/30 flex justify-center pt-1.5">
      <div class="w-1 h-2 rounded-full bg-text-muted/50 animate-bounce"></div>
    </div>
  </div>
</section>
