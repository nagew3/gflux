---
const calendlyUrl = "https://calendly.com/gawen-francois/audit-perte-de-temps-gflux";
---

<section id="hero" class="relative min-h-screen flex items-center pt-20 pb-16 overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-white via-surface to-accent-blue/5 -z-10"></div>
  <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent-blue/5 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-1/4 -left-32 w-80 h-80 bg-deep-blue/5 rounded-full blur-3xl -z-10"></div>

  <div class="container-narrow w-full">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div class="reveal inline-flex items-center gap-2 badge bg-accent-blue/10 text-accent-blue mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-blue animate-pulse-soft"></span>
        Offert aux 5 prochaines ESN
      </div>

      <!-- Headline -->
      <h1 class="reveal font-display text-hero text-deep-tech mb-6 tracking-tight" style="transition-delay: 0.1s">
        Dirigeants d'ESN : <br class="hidden sm:block"/>
        <span class="bg-gradient-to-r from-accent-blue to-deep-blue bg-clip-text text-transparent">Éradiquez 10h</span>
        de votre temps stratégique chaque semaine
      </h1>

      <!-- Sub-headline -->
      <p class="reveal text-sub text-text-secondary max-w-2xl mx-auto mb-10" style="transition-delay: 0.2s">
        Ne laissez plus une erreur de facture ou un mail client manqué freiner votre croissance.
        Transformez votre <strong class="text-deep-tech">"dette opérationnelle"</strong> en moteur de closing.
      </p>

      <!-- Interactive Impact Calculator -->
      <div class="reveal max-w-xl mx-auto mb-10" style="transition-delay: 0.3s">
        <div class="relative bg-white rounded-3xl p-6 md:p-8 shadow-card border border-deep-tech/5">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="badge bg-red-50 text-red-600 border border-red-100">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 002.25 2.25h10.5a2.25 2.25 0 002.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0012 2.25z" /></svg>
              Simulez votre impact
            </span>
          </div>

          <!-- Slider: Hourly Rate -->
          <div class="mt-4 mb-5">
            <div class="flex justify-between items-center mb-2">
              <label for="rate-slider" class="text-sm text-text-secondary font-medium">Valeur de votre heure</label>
              <span id="rate-display" class="text-sm font-bold text-deep-tech">200 €/h</span>
            </div>
            <input
              type="range"
              id="rate-slider"
              min="100"
              max="500"
              step="25"
              value="200"
              class="w-full h-2 bg-surface-alt rounded-full appearance-none cursor-pointer accent-accent-blue"
            />
            <div class="flex justify-between text-xs text-text-muted mt-1">
              <span>100 €</span>
              <span>500 €</span>
            </div>
          </div>

          <!-- Slider: Hours -->
          <div class="mb-6">
            <div class="flex justify-between items-center mb-2">
              <label for="hours-slider" class="text-sm text-text-secondary font-medium">Heures admin / semaine</label>
              <span id="hours-display" class="text-sm font-bold text-deep-tech">10h</span>
            </div>
            <input
              type="range"
              id="hours-slider"
              min="5"
              max="20"
              step="1"
              value="10"
              class="w-full h-2 bg-surface-alt rounded-full appearance-none cursor-pointer accent-accent-blue"
            />
            <div class="flex justify-between text-xs text-text-muted mt-1">
              <span>5h</span>
              <span>20h</span>
            </div>
          </div>

          <!-- Result -->
          <div class="bg-gradient-to-r from-red-50 to-amber-50 rounded-2xl p-5 border border-red-100/50">
            <p class="text-text-secondary text-sm mb-2">Vous jetez chaque semaine</p>
            <div class="flex items-baseline justify-center gap-1">
              <span id="impact-counter" class="font-display text-4xl md:text-5xl font-bold text-accent-blue">2 000</span>
              <span class="text-text-secondary text-lg">€ à la poubelle</span>
            </div>
            <p class="text-text-muted text-xs mt-2">soit <span id="impact-monthly" class="font-semibold text-red-600">8 000 €</span> par mois perdus en tâches sans valeur</p>
          </div>
        </div>
      </div>

      <!-- Single CTA -->
      <div class="reveal flex flex-col items-center justify-center gap-3" style="transition-delay: 0.4s">
        <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-lg !px-10 !py-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
          Réserver mon diagnostic gratuit
        </a>
        <span class="text-xs text-text-muted">Gratuit · Sans engagement · 30 min</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive ROI Calculator
  const rateSlider = document.getElementById('rate-slider') as HTMLInputElement;
  const hoursSlider = document.getElementById('hours-slider') as HTMLInputElement;
  const rateDisplay = document.getElementById('rate-display');
  const hoursDisplay = document.getElementById('hours-display');
  const impactCounter = document.getElementById('impact-counter');
  const impactMonthly = document.getElementById('impact-monthly');

  function updateCalculation() {
    if (!rateSlider || !hoursSlider || !rateDisplay || !hoursDisplay || !impactCounter || !impactMonthly) return;

    const rate = parseInt(rateSlider.value);
    const hours = parseInt(hoursSlider.value);
    const weekly = rate * hours;
    const monthly = weekly * 4;

    rateDisplay.textContent = `${rate} €/h`;
    hoursDisplay.textContent = `${hours}h`;
    impactCounter.textContent = weekly.toLocaleString('fr-FR');
    impactMonthly.textContent = `${monthly.toLocaleString('fr-FR')} €`;
  }

  rateSlider?.addEventListener('input', updateCalculation);
  hoursSlider?.addEventListener('input', updateCalculation);
</script>

<style>
  /* Custom slider styling */
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #2563EB;
    cursor: pointer;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    transition: box-shadow 0.2s ease;
  }

  input[type="range"]::-webkit-slider-thumb:hover {
    box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.25);
  }

  input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #2563EB;
    cursor: pointer;
    border: none;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
  }
</style>
