---
// components/Navbar.astro
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-deep-blue to-accent-blue flex items-center justify-center text-white font-bold text-xl shadow-glow transition-transform group-hover:scale-105">
            G
          </div>
          <span class="font-display font-bold text-xl tracking-tight text-deep-tech">
            GFlux
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-10 items-center">
        <a href="#systeme" class="text-text-secondary hover:text-deep-blue font-medium transition-colors">Le Système</a>
        <a href="#processus" class="text-text-secondary hover:text-deep-blue font-medium transition-colors">Processus</a>
        <a href="#expertise" class="text-text-secondary hover:text-deep-blue font-medium transition-colors">Expertise</a>
        <a href="#calendly" class="bg-brand-orange hover:bg-brand-orange-hover text-white px-6 py-2.5 rounded-full font-semibold transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
          Audit Stratégique Offert
        </a>
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-text-secondary hover:text-deep-tech p-2">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('navbar');
    if (window.scrollY > 20) {
      nav.classList.add('shadow-soft');
    } else {
      nav.classList.remove('shadow-soft');
    }
  });
</script>
