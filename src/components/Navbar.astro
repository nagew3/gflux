---
const navLinks = [
  { label: 'Problème', href: '#probleme' },
  { label: 'Solution', href: '#solution' },
  { label: 'Offre', href: '#offre' },
];
---

<div class="fixed top-0 inset-x-0 z-50 flex justify-center px-4 pt-6 pointer-events-none">
  <nav id="navbar" class="pointer-events-auto relative flex items-center justify-between px-6 py-3 w-full max-w-5xl rounded-full bg-[#0B0C0F]/70 backdrop-blur-xl border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.4)] transition-all duration-500">
    
    <!-- Subtle Top Glow -->
    <div class="absolute inset-x-8 top-0 h-[1px] bg-gradient-to-r from-transparent via-tech-blue/30 to-transparent"></div>

    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group relative z-10">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-deep-navy to-tech-blue p-[1px] transition-transform duration-500 group-hover:scale-105 shadow-[0_0_15px_rgba(27,127,248,0.2)]">
        <div class="w-full h-full rounded-[11px] bg-[#0B0C0F] flex items-center justify-center">
          <span class="text-white font-display font-bold text-sm tracking-wider">G</span>
        </div>
      </div>
      <span class="font-display font-bold text-lg text-white tracking-wide">GFlux</span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-1 bg-white/[0.03] rounded-full p-1 border border-white/[0.05]">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="relative px-5 py-2 text-sm font-medium text-text-secondary hover:text-white transition-colors duration-300 rounded-full hover:bg-white/[0.05]"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA & Mobile Toggle -->
    <div class="flex items-center gap-4 relative z-10">
      <a href="#offre" class="hidden md:inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-tech-blue text-white text-sm font-medium transition-all duration-300 hover:bg-blue-600 hover:shadow-[0_0_20px_rgba(27,127,248,0.4)] hover:-translate-y-0.5">
        Réserver <span class="hidden lg:inline">mon audit</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>

      <!-- Mobile Menu Button -->
      <button id="mobile-toggle" class="md:hidden relative w-10 h-10 flex items-center justify-center rounded-full bg-white/[0.05] border border-white/[0.1] text-white hover:bg-white/[0.1] transition-colors" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>
</div>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-[#0B0C0F]/95 backdrop-blur-2xl opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center">
  <div class="flex flex-col items-center gap-8 w-full px-6 translate-y-8 transition-transform duration-500" id="mobile-menu-content">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="text-2xl font-display font-medium text-text-secondary hover:text-white transition-colors"
      >
        {link.label}
      </a>
    ))}
    <a href="#offre" class="w-full max-w-xs mt-4 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-tech-blue text-white text-lg font-medium shadow-[0_0_30px_rgba(27,127,248,0.3)]">
      Réserver mon audit
    </a>
  </div>
</div>

<script>
  // Mobile menu toggle logic
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileContent = document.getElementById('mobile-menu-content');
  const menuIcon = document.getElementById('menu-icon');
  let isMenuOpen = false;

  const closeMenu = () => {
    isMenuOpen = false;
    mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto');
    mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
    mobileContent?.classList.add('translate-y-8');
    mobileContent?.classList.remove('translate-y-0');
    menuIcon?.setAttribute('d', 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5');
    document.body.style.overflow = '';
  };

  const openMenu = () => {
    isMenuOpen = true;
    mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenu?.classList.add('opacity-100', 'pointer-events-auto');
    mobileContent?.classList.remove('translate-y-8');
    mobileContent?.classList.add('translate-y-0');
    // Change to X icon
    menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
    document.body.style.overflow = 'hidden'; // Prevent scrolling
  };

  toggleBtn?.addEventListener('click', () => {
    if (isMenuOpen) closeMenu();
    else openMenu();
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Dynamic Navbar Shrink on Scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('py-2', 'bg-[#0B0C0F]/90');
      navbar?.classList.remove('py-3', 'bg-[#0B0C0F]/70');
    } else {
      navbar?.classList.add('py-3', 'bg-[#0B0C0F]/70');
      navbar?.classList.remove('py-2', 'bg-[#0B0C0F]/90');
    }
  });
</script>
