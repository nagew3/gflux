---
const problems = [
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" class="w-8 h-8"><rect width="48" height="48" rx="10" fill="#171717" stroke="white" stroke-opacity="0.12"/><path d="M14 34V24c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2v10M24 34V18c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2v16M34 34V12c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2v22" fill="#262626"/><rect x="34" y="10" width="8" height="24" rx="2" fill="#1b7ff8" fill-opacity="0.8"/></svg>`,
    title: "Opportunités perdues",
    description: "Ce contrat loupé parce qu'un document important a été noyé sous les notifications quotidiennes.",
    span: "md:col-span-2",
  },
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" class="w-8 h-8"><rect width="48" height="48" rx="10" fill="#171717" stroke="white" stroke-opacity="0.12"/><path fill-rule="evenodd" clip-rule="evenodd" d="M24 8L10 14v10c0 9 14 16 14 16s14-7 14-16V14L24 8zm0 20c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z" fill="#262626"/><circle cx="24" cy="22" r="3" fill="#8a1404" fill-opacity="0.8"/></svg>`,
    title: "Risques critiques",
    description: "Échéances passées et erreurs de facturation manuelles dues à la fatigue.",
    span: "md:col-span-1",
  },
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" class="w-8 h-8"><rect width="48" height="48" rx="10" fill="#171717" stroke="white" stroke-opacity="0.12"/><rect x="12" y="14" width="24" height="4" rx="2" fill="#404040"/><rect x="12" y="22" width="24" height="4" rx="2" fill="#404040"/><rect x="12" y="30" width="16" height="4" rx="2" fill="#404040"/><circle cx="34" cy="32" r="4" fill="#1b7ff8" fill-opacity="0.8"/></svg>`,
    title: "Surcharge mentale",
    description: "Vos soirées dévorées par la gestion de l'urgent et l'administratif.",
    span: "md:col-span-1",
  },
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" class="w-8 h-8"><rect width="48" height="48" rx="10" fill="#171717" stroke="white" stroke-opacity="0.12"/><path d="M28 12h10v10l-4-4-12 12-8-8-10 10v-5l10-10 8 8 9-9-3-4z" fill="#262626"/><path d="M24 20l5-5 5 5H24z" fill="#1b7ff8" fill-opacity="0.8"/></svg>`,
    title: "Croissance bridée",
    description: "Pendant que vous triez des documents, vos concurrents innovent et recrutent les meilleurs talents. Sortez de l'opérationnel.",
    span: "md:col-span-2",
  },
];
---

<section id="probleme" class="section-padding bg-black relative">
  <!-- Subtle top gradient -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-bento-border to-transparent"></div>

  <div class="container-narrow">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="reveal font-display text-3xl md:text-5xl text-white mb-6">
        Le coût invisible de la <br class="hidden sm:block"/><span class="text-text-muted">gestion manuelle.</span>
      </h2>
      <p class="reveal text-text-secondary text-lg font-light">
        Vos équipes perdent jusqu'à 2 jours par semaine sur des tâches répétitives.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
      {problems.map((problem, i) => (
        <div
          class={`reveal group relative flex flex-col justify-end overflow-hidden rounded-3xl bg-surface border border-bento-border p-8 min-h-[250px] transition-all duration-500 hover:border-text-muted/50 ${problem.span}`}
          style={`transition-delay: ${i * 0.1}s`}
        >
          <!-- Hover glow effect -->
          <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <div class="h-full flex flex-col p-6 sm:p-8">
            <div class="mb-auto inline-flex items-center justify-center w-12 h-12 rounded-xl bg-surface-alt border border-bento-border text-white shadow-[0_4px_20px_rgba(0,0,0,0.5)] transition-transform duration-500 group-hover:scale-110 group-hover:text-tech-blue">
              <Fragment set:html={problem.icon} />
            </div>
            <h3 class="font-display text-xl font-medium text-white mt-8 mb-2">
              {problem.title}
            </h3>
            <p class="text-text-secondary font-light text-sm md:text-base">
              {problem.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
