---
const problems = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 01-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 001.183 1.981l6.478 3.488m8.839 2.51l-4.66-2.51m0 0l-1.023-.55a2.25 2.25 0 00-2.134 0l-1.022.55m0 0l-4.661 2.51" /></svg>`,
    title: "Opportunités perdues",
    description: "Ce gros contrat loupé parce qu'un mail important a été noyé sous les notifications.",
    accent: "bg-amber-50 text-amber-600 border-amber-100",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z" /></svg>`,
    title: "Risques critiques",
    description: "Échéances bancaires passées ou erreurs de facturation qui impactent votre trésorerie.",
    accent: "bg-red-50 text-red-600 border-red-100",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
    title: "Vie personnelle sacrifiée",
    description: "Vos dimanches soirs sont dévorés par la gestion de l'urgent au détriment de l'important.",
    accent: "bg-purple-50 text-purple-600 border-purple-100",
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>`,
    title: "Croissance bridée",
    description: "Pendant que vous triez des mails, vos concurrents closent des deals et recrutent les meilleurs talents.",
    accent: "bg-blue-50 text-blue-600 border-blue-100",
  },
];
---

<section id="probleme" class="section-padding bg-surface">
  <div class="container-narrow">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal badge bg-red-50 text-red-600 border border-red-100 mb-6">
        Le problème
      </div>
      <h2 class="reveal font-display text-section text-deep-tech mb-5">
        Le coût <span class="text-accent-blue">invisible</span> de la gestion manuelle
      </h2>
      <p class="reveal text-text-secondary text-lg">
        Chaque heure passée sur des tâches administratives est une heure volée à votre croissance stratégique.
      </p>
    </div>

    <!-- Problem Cards Grid -->
    <div class="grid md:grid-cols-2 gap-5 md:gap-6">
      {problems.map((problem, i) => (
        <div
          class="reveal group bg-white rounded-2xl p-6 md:p-8 border border-deep-tech/5 hover:border-accent-blue/20 hover:shadow-card transition-all duration-500"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl border ${problem.accent} mb-5 transition-transform duration-300 group-hover:scale-110`}>
            <Fragment set:html={problem.icon} />
          </div>
          <h3 class="font-display text-lg font-bold text-deep-tech mb-3">
            {problem.title}
          </h3>
          <p class="text-text-secondary leading-relaxed">
            {problem.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Bottom emphasis -->
    <div class="reveal text-center mt-12">
      <p class="text-text-secondary text-base">
        <strong class="text-deep-tech">Résultat ?</strong> Vous êtes coincé dans un cercle vicieux qui freine votre développement.
      </p>
    </div>
  </div>
</section>
