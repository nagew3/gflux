---
// Logo GFlux : monogramme PNG + nom. La variante "light" passe le monogramme en blanc (fond sombre).
export interface Props {
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;
const textColor = variant === "light" ? "#F7F2E9" : "#0F1A2B";
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <img
    src="/logo-gflux.png"
    alt=""
    width="47"
    height="30"
    class="h-[30px] w-auto"
    style={variant === "light" ? "filter:brightness(0) invert(1)" : undefined}
  />
  <span class="font-bold text-lg tracking-tight" style={`color:${textColor}`}>GFlux</span>
</span>
