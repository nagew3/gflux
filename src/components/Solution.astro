---
// components/Solution.astro
---

<section id="systeme" class="py-24 bg-deep-tech relative text-white overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
    <div class="absolute top-0 right-[10%] w-[500px] h-[500px] bg-accent-blue rounded-full blur-[120px]"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[400px] h-[400px] bg-brand-orange/40 rounded-full blur-[100px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-20 reveal">
      <h2 class="font-display text-section mb-6">
        La Solution : Un système, pas un outil.
      </h2>
      <p class="text-lg text-gray-300">
        GFlux n'est pas un abonnement logiciel de plus. C'est la conception et la mise en œuvre de votre propre moteur administratif IA, sur mesure, piloté par un humain (vous).
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 items-center">
      
      <!-- Visual Represenation -->
      <div class="w-full lg:w-1/2 reveal">
        <div class="glass-dark rounded-3xl p-8 border border-white/20 shadow-2xl relative">
          <!-- Mockup Header -->
          <div class="flex items-center gap-2 mb-8 pb-4 border-b border-white/10">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
            <span class="text-xs text-gray-400 ml-4 font-mono">GFlux Architecture</span>
          </div>

          <!-- Workflow illustration inside the dark card -->
          <div class="space-y-4">
            <!-- Row 1 -->
            <div class="flex items-center gap-4 bg-white/5 rounded-xl p-4">
              <div class="w-10 h-10 bg-accent-blue/20 flex items-center justify-center rounded-lg text-xl">📥</div>
              <div class="flex-1">
                <div class="h-2 w-24 bg-gray-400 rounded-full mb-2"></div>
                <div class="h-2 w-16 bg-gray-600 rounded-full"></div>
              </div>
              <div class="text-xs py-1 px-3 bg-white/10 rounded-full text-gray-300">Entrées Multiples</div>
            </div>
            
            <!-- Connection -->
            <div class="w-1 h-6 bg-brand-orange/50 mx-auto rounded-full"></div>

            <!-- Row 2 -->
            <div class="flex items-center gap-4 bg-brand-orange/10 border border-brand-orange/30 rounded-xl p-4 transform scale-105 shadow-glow">
              <div class="w-10 h-10 bg-brand-orange flex items-center justify-center rounded-lg text-xl">🧠</div>
              <div class="flex-1">
                <div class="text-sm font-semibold text-white mb-1">Cerveau GFlux (IA Sur Mesure)</div>
                <div class="text-xs text-brand-orange">Tri, Analyse, Rédaction, Dispatch</div>
              </div>
            </div>

            <!-- Connection -->
            <div class="w-1 h-6 bg-accent-blue/50 mx-auto rounded-full"></div>

            <!-- Row 3 -->
            <div class="flex items-center gap-4 bg-white/5 rounded-xl p-4">
              <div class="w-10 h-10 bg-green-500/20 flex items-center justify-center rounded-lg text-xl">✅</div>
              <div class="flex-1">
                <div class="h-2 w-32 bg-gray-400 rounded-full mb-2"></div>
                <div class="h-2 w-20 bg-gray-600 rounded-full"></div>
              </div>
              <div class="text-xs py-1 px-3 bg-white/10 rounded-full text-gray-300">HubSpot / Notion / Outlook</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature/Points List -->
      <div class="w-full lg:w-1/2 space-y-8 reveal delay-100">
        
        <div class="flex items-start gap-4">
          <div class="mt-1 w-8 h-8 rounded-full bg-accent-blue/20 flex items-center justify-center text-accent-light font-bold">1</div>
          <div>
            <h3 class="text-xl font-bold mb-2">Centralisation Intelligente</h3>
            <p class="text-gray-400">Vos emails, factures et cahiers des charges sont analysés en temps réel. Plus aucune information ne se perd.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="mt-1 w-8 h-8 rounded-full bg-brand-orange/20 flex items-center justify-center text-brand-orange font-bold">2</div>
          <div>
            <h3 class="text-xl font-bold mb-2">Zéro Changement D'Outils</h3>
            <p class="text-gray-400">Le système est construit *autour* de vos logiciels (Gmail, Outlook, Slack, Pipedrive). Pas de nouveauté technique complexe à imposer aux équipes.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="mt-1 w-8 h-8 rounded-full bg-accent-blue/20 flex items-center justify-center text-accent-light font-bold">3</div>
          <div>
            <h3 class="text-xl font-bold mb-2">Garde Fou Humain</h3>
            <p class="text-gray-400">L'IA prépare le travail, vous validez. Un brouillon d'e-mail ou une tâche créée reste en attente de votre simple clic. Vous gardez 100% du contrôle.</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
