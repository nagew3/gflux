---
// Illustration du blocage n°1 : trois outils qui ne se parlent pas.
import Icon from "../icons/Icon.astro";

const tools = [
  { icon: "mail", label: "Mail" },
  { icon: "layers", label: "Pennylane" },
  { icon: "file", label: "Excel de suivi" },
] as const;
---

<div class="flex items-center" role="img" aria-label="Le mail, Pennylane et le fichier Excel de suivi ne sont pas reliés entre eux.">
  {tools.map((tool, i) => (
    <>
      {i > 0 && (
        <span class="relative flex-1 min-w-4 border-t border-dashed border-[rgba(91,100,114,0.4)]">
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-bg-primary border border-border-subtle text-accent flex items-center justify-center">
            <Icon name="close" class="w-3 h-3" />
          </span>
        </span>
      )}
      <div class="bezel-shell !p-1 flex-shrink-0">
        <div class="bezel-core !rounded-[1.4rem] px-4 py-4 flex flex-col items-center gap-2 w-[5.5rem] sm:w-24">
          <Icon name={tool.icon} class="icon-mark w-5 h-5" />
          <p class="text-[11px] font-semibold text-text-primary text-center leading-tight">{tool.label}</p>
        </div>
      </div>
    </>
  ))}
</div>
