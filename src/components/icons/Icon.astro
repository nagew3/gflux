---
// Jeu de pictogrammes linéaires simples et cohérents, dessinés pour GFlux.
// Un seul fichier centralise les tracés afin de garder un style homogène.
export interface Props {
  name:
    | "mail"
    | "file"
    | "bell"
    | "receipt"
    | "gauge"
    | "link-broken"
    | "repeat"
    | "alert"
    | "lock"
    | "layers"
    | "shield-check"
    | "history"
    | "scale"
    | "compass"
    | "flow"
    | "eye"
    | "balance"
    | "check"
    | "chevron-down"
    | "menu"
    | "close"
    | "arrow-right";
  class?: string;
}

const { name, class: className = "" } = Astro.props;

const paths: Record<string, string> = {
  mail: "M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z M3.5 7 12 13 20.5 7",
  file: "M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z M14 3v5h5 M9 13h6 M9 17h6",
  bell: "M6 10a6 6 0 0 1 12 0v4l1.5 3h-15L6 14Z M10 20a2 2 0 0 0 4 0",
  receipt: "M6 3h12v18l-2.5-1.5L13 21l-1-1.5L10.5 21 8 19.5 6 21Z M9 8h6 M9 12h6 M9 16h4",
  gauge: "M12 21a9 9 0 1 1 9-9 M12 21a9 9 0 0 1-9-9 M12 12l4-4 M12 3v2 M4.2 7.8l1.4 1.4 M19.8 7.8l-1.4 1.4",
  "link-broken": "M9 15l6-6 M8 8l-1.5-1.5a3 3 0 0 1 4.24-4.24L12 3.5 M16 16l1.5 1.5a3 3 0 0 1-4.24 4.24L12 20.5 M14 4l2 2-2 2 M8 18l2 2 2-2",
  repeat: "M4 7h13a3 3 0 0 1 3 3v2 M20 17H7a3 3 0 0 1-3-3v-2 M7 4 4 7l3 3 M17 20l3-3-3-3",
  alert: "M12 3 2 20h20L12 3Z M12 10v4 M12 17h.01",
  lock: "M6 11h12v9H6z M9 11V7a3 3 0 0 1 6 0v4 M12 15v2",
  layers: "M12 3 3 8l9 5 9-5-9-5Z M3 13l9 5 9-5 M3 18l9 5 9-5",
  "shield-check": "M12 3 5 6v6c0 4.4 3 7.5 7 9 4-1.5 7-4.6 7-9V6l-7-3Z M9.5 12.5l1.8 1.8L15 10.5",
  history: "M12 8v5l3 2 M4 12a8 8 0 1 1 2.6 5.9 M4 12H2 M4 12l2.5-2 M4 12l2.5 2",
  scale: "M12 3v18 M6 21h12 M4 8l4-3 4 3 M16 8l4-3 4 3 M4 8l-2 5a3 3 0 0 0 6 0Z M20 8l-2 5a3 3 0 0 0 6 0Z",
  compass: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M14.5 9.5 13 13l-3.5 1.5L11 11l3.5-1.5Z",
  flow: "M4 6h6v4H4z M14 6h6v4h-6z M9 8h5 M7 10v4h5v-4 M14 14h6v4h-6z M12 14v-2",
  eye: "M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  balance: "M4 4h11 M9 4v16 M4 20h10 M5 8l-2.5 5h5L5 8Z M15 6l-2.5 5h5L15 6Z",
  check: "m5 13 4 4L19 7",
  "chevron-down": "m6 9 6 6 6-6",
  menu: "M4 7h16 M4 12h16 M4 17h16",
  close: "M6 6l12 12 M18 6 6 18",
  "arrow-right": "M5 12h14 M13 6l6 6-6 6",
};
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].split(" M").map((segment, i) => (
    <path d={i === 0 ? segment : `M${segment}`} />
  ))}
</svg>
