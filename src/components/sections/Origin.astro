---
import { origin } from "../../config/siteContent";
---

<section id="origine" class="section-padding">
  <div class="container-page max-w-3xl">
    <h2 class="text-section mb-6">{origin.h2}</h2>
    <p class="text-text-secondary leading-relaxed mb-8">{origin.text}</p>

    <blockquote class="border-l-2 border-accent pl-6 py-1 mb-8">
      <p class="text-xl md:text-2xl font-accent-serif text-text-primary leading-snug">{origin.belief}</p>
    </blockquote>

    <p class="text-text-secondary leading-relaxed mb-8">{origin.vision}</p>

    <div class="bg-ink-light rounded-lg-soft p-6">
      <p class="text-text-primary leading-relaxed">{origin.qualification}</p>
    </div>
  </div>
</section>
