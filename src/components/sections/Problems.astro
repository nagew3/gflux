---
import Icon from "../icons/Icon.astro";
import Quote from "../Quote.astro";
import { problems } from "../../config/siteContent";

const icons = ["mail", "bell", "file", "gauge", "repeat"] as const;
const [lead, ...rest] = problems.items;
---

<section id="problemes" class="section-padding bg-bg-secondary">
  <div class="container-page">
    <div class="max-w-3xl mb-16">
      <p class="kicker">01 · Problèmes</p>
      <h2 class="text-section mb-7">{problems.h2}</h2>
      <p class="text-xl md:text-2xl text-text-primary font-medium leading-snug tracking-tight">{problems.intro}</p>
    </div>

    <!-- Bento asymétrique : le problème n°1 (la boîte mail) en grande carte, les quatre autres en 2 × 2 -->
    <div class="grid md:grid-cols-2 lg:grid-cols-12 gap-5">
      <div class="reveal md:col-span-2 lg:col-span-4 lg:row-span-2">
        <div class="bezel-shell bezel-fill">
          <div class="bezel-core bezel-core-ink p-8 md:p-9 flex flex-col">
            <Icon name={icons[0]} class="w-6 h-6 text-accent mb-6" />
            <h3 class="text-xl font-semibold text-white mb-3 tracking-tight">{lead.h3}</h3>
            <p class="text-[15px] text-white/70 leading-relaxed">{lead.text}</p>
            {lead.quote && <Quote {...lead.quote} tone="invert" class="mt-10 lg:mt-auto lg:pt-0" />}
          </div>
        </div>
      </div>

      {rest.map((item, i) => (
        <div class="reveal lg:col-span-4" style={`--reveal-delay: ${(i + 1) * 70}ms`}>
          <div class="bezel-shell bezel-fill">
            <div class="bezel-core p-7 md:p-8">
              <Icon name={icons[i + 1]} class="icon-mark w-6 h-6 mb-6" />
              <h3 class="text-base font-semibold mb-2 tracking-tight">{item.h3}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{item.text}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
