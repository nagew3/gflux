---
import { closing, CTA_LABEL, URL_CALENDLY_AUDIT } from "../../config/siteContent";
---

<section id="closing" class="section-padding">
  <div class="container-page max-w-2xl text-center">
    <h2 class="text-section mb-5">{closing.h2}</h2>
    <p class="text-text-secondary leading-relaxed mb-8">{closing.text}</p>

    <a href={URL_CALENDLY_AUDIT} target="_blank" rel="noopener noreferrer" class="btn-primary">
      {CTA_LABEL}
    </a>
    <p class="text-sm text-text-secondary mt-4">{closing.reassurance}</p>
  </div>
</section>
