---
import Icon from "../icons/Icon.astro";
import Comparison from "./Comparison.astro";
import { audit, CTA_LABEL, URL_CALENDLY_AUDIT } from "../../config/siteContent";
---

<section id="audit" class="pt-6 md:pt-10">
  <!-- Panneau navy flottant : la section principale se détache du fond comme un bloc à part -->
  <div class="px-3 sm:px-5">
    <div
      class="relative overflow-hidden bg-ink rounded-[2rem] md:rounded-[2.5rem] max-w-[1400px] mx-auto"
      style="background-image: radial-gradient(700px circle at 88% -10%, rgba(230, 81, 0, 0.22), transparent 60%), radial-gradient(600px circle at 0% 110%, rgba(255, 255, 255, 0.07), transparent 60%);"
    >
      <div class="container-page py-20 md:py-28">
        <div class="grid lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.9fr)] gap-14 lg:gap-20">
          <div>
            <p class="kicker kicker-invert">06 · Audit offert</p>
            <h2 class="text-section text-white mb-6">{audit.h2}</h2>
            <p class="text-lg text-white/75 leading-relaxed mb-8 max-w-measure">{audit.intro}</p>

            <ol class="border-t border-white/15 divide-y divide-white/15 mb-10">
              {audit.takeaways.map((item, i) => (
                <li class="reveal flex items-start gap-5 py-5" style={`--reveal-delay: ${i * 80}ms`}>
                  <span class="numeral text-3xl flex-shrink-0 w-8">{i + 1}</span>
                  <span class="text-white text-lg font-medium leading-snug pt-1">{item}</span>
                </li>
              ))}
            </ol>

            <a href={URL_CALENDLY_AUDIT} target="_blank" rel="noopener noreferrer" class="btn-invert w-full sm:w-auto">
              {CTA_LABEL}
            </a>
            <p class="text-base font-medium text-white mt-5">{audit.microcopy}</p>
          </div>

          <div class="space-y-4 lg:pt-12">
            {audit.reasons.map((reason, i) => (
              <div class="reveal rounded-[1.75rem] p-1.5 bg-white/[0.04] ring-1 ring-white/10" style={`--reveal-delay: ${i * 90}ms`}>
                <div class="rounded-[calc(1.75rem-0.375rem)] bg-white/[0.05] shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)] p-6 md:p-7">
                  <h3 class="text-base font-semibold text-white mb-2 tracking-tight">{reason.h3}</h3>
                  <p class="text-[15px] text-white/70 leading-relaxed">{reason.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container-page pt-16 md:pt-20 pb-24 md:pb-32">
    <h3 class="kicker">{audit.afterH3}</h3>
    <ol class="grid md:grid-cols-3 gap-x-10 gap-y-6 mb-24 md:mb-32">
      {audit.after.map((step, i) => (
        <li class="reveal flex items-start gap-3" style={`--reveal-delay: ${i * 80}ms`}>
          <Icon name="arrow-right" class="w-4 h-4 text-accent flex-shrink-0 mt-1" />
          <p class="text-sm text-text-secondary leading-relaxed">
            <strong class="font-semibold text-text-primary">{step.title}</strong> {step.text}
          </p>
        </li>
      ))}
    </ol>

    <Comparison />
  </div>
</section>
