---
import Icon from "../icons/Icon.astro";
import { faq } from "../../config/siteContent";
---

<section id="faq" class="section-padding bg-bg-secondary">
  <div class="container-page grid lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)] gap-10 lg:gap-24">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <p class="kicker">07 · FAQ</p>
      <h2 class="text-section">{faq.h2}</h2>
    </div>

    <div class="faq-list border-t border-border-subtle">
      {faq.items.map((item, i) => (
        <div class="border-b border-border-subtle">
          <h3>
            <button
              type="button"
              class="faq-trigger w-full flex items-center justify-between gap-4 py-6 text-left text-lg font-medium text-text-primary tracking-tight"
              aria-expanded="false"
              aria-controls={`faq-panel-${i}`}
              id={`faq-trigger-${i}`}
            >
              <span>{item.question}</span>
              <Icon name="chevron-down" class="faq-chevron w-5 h-5 text-accent flex-shrink-0 transition-transform duration-250" />
            </button>
          </h3>
          <div
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-trigger-${i}`}
            class="faq-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-450 ease-[cubic-bezier(0.32,0.72,0,1)]"
          >
            <div class="overflow-hidden">
              <p class="text-text-secondary leading-relaxed pb-6 pr-8 max-w-measure">{item.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(".faq-trigger");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      const panel = document.getElementById(trigger.getAttribute("aria-controls") || "");
      const chevron = trigger.querySelector(".faq-chevron");

      trigger.setAttribute("aria-expanded", String(!isOpen));
      panel?.classList.toggle("grid-rows-[1fr]", !isOpen);
      panel?.classList.toggle("grid-rows-[0fr]", isOpen);
      chevron?.classList.toggle("rotate-180", !isOpen);
    });
  });
</script>
