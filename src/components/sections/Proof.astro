---
import RestitutionMock from "../visuals/RestitutionMock.astro";
import { proof } from "../../config/siteContent";
---

<section id="preuves" class="section-padding bg-bg-secondary">
  <div class="container-page">
    <div class="max-w-3xl mb-16">
      <p class="kicker">05 · Preuves</p>
      <h2 class="text-section">{proof.h2}</h2>
    </div>

    <div class="grid lg:grid-cols-12 gap-5">
      <div class="reveal lg:col-span-7">
        <div class="bezel-shell bezel-fill">
          <div class="bezel-core p-7 md:p-10 flex flex-col">
            <h3 class="text-xl font-semibold mb-3 tracking-tight">{proof.partner.h3}</h3>
            <p class="text-text-secondary leading-relaxed mb-8 max-w-measure">{proof.partner.text}</p>
            <RestitutionMock />
            <div class="mt-8 pt-6 border-t border-border-subtle">
              <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-text-secondary mb-2">{proof.partner.resultLabel}</p>
              <p class="numeral text-3xl md:text-4xl leading-tight">{proof.partner.result}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal lg:col-span-5" style="--reveal-delay: 90ms">
        <div class="bezel-shell bezel-fill">
          <div class="bezel-core bezel-core-ink p-7 md:p-10">
            <p class="numeral text-7xl md:text-8xl mb-6" aria-hidden="true">16</p>
            <h3 class="text-xl font-semibold text-white mb-3 tracking-tight">{proof.survey.h3}</h3>
            <p class="text-[15px] text-white/70 leading-relaxed">{proof.survey.text}</p>
          </div>
        </div>
      </div>

      <div class="reveal lg:col-span-12">
        <div class="bezel-shell">
          <div class="bezel-core p-7 md:p-10 grid md:grid-cols-[auto_minmax(0,1fr)] gap-8 md:gap-12 items-start">
            <div class="flex md:flex-col items-center md:items-start gap-5">
              <img src={proof.founder.photo} alt={proof.founder.name} width="112" height="112" loading="lazy" decoding="async" class="rounded-full object-cover w-24 h-24 md:w-28 md:h-28 flex-shrink-0" />
              <div>
                <p class="font-semibold text-text-primary">{proof.founder.name}</p>
                <p class="text-sm text-text-secondary">{proof.founder.role}</p>
              </div>
            </div>
            <div>
              <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-text-secondary mb-4">{proof.founder.h3}</h3>
              <p class="font-accent-serif text-xl md:text-2xl text-text-primary leading-snug max-w-3xl">{proof.founder.bio}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
