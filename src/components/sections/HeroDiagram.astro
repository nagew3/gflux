---
import Icon from "../icons/Icon.astro";
import { hero } from "../../config/siteContent";

const icons = ["mail", "layers", "compass", "shield-check", "file"] as const;
---

<div class="relative pb-8 md:pb-12 md:pr-6">
  <div class="bezel-shell" role="img" aria-label={hero.diagramAlt}>
    <div class="bezel-core p-7 md:p-9">
      <ol class="flex flex-col gap-0">
        {hero.diagram.map((step, i) => (
          <li class="relative flex gap-5 pb-9 last:pb-0">
            {i < hero.diagram.length - 1 && (
              <span class="absolute left-[15px] top-9 bottom-0 w-px bg-border-subtle" aria-hidden="true"></span>
            )}
            <span class="relative z-10 flex-shrink-0 w-8 h-8 rounded-full border border-accent/35 bg-bg-secondary text-accent flex items-center justify-center">
              <Icon name={icons[i]} class="w-4 h-4" />
            </span>
            <p class="text-sm md:text-[15px] text-text-primary pt-1 leading-snug">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="hidden md:flex absolute -bottom-1 -right-2 lg:-right-6 items-center gap-3 bg-bg-secondary border border-border-subtle rounded-2xl shadow-lifted px-5 py-4 rotate-[-3deg]">
    <span class="flex-shrink-0 w-9 h-9 rounded-full bg-ink text-white flex items-center justify-center">
      <Icon name="shield-check" class="w-4 h-4" />
    </span>
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-wide text-text-secondary">Validation</p>
      <p class="text-sm font-semibold text-text-primary">Contrôle humain systématique</p>
    </div>
  </div>
</div>
