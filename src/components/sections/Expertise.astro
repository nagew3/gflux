---
import Icon from "../icons/Icon.astro";
import { expertise, flags } from "../../config/siteContent";

const icons = ["layers", "shield-check", "history", "scale"] as const;
const showFounder = flags.showFounderBio || import.meta.env.DEV;
---

<section id="expertise" class="section-padding bg-bg-secondary">
  <div class="container-page">
    <div class="max-w-measure mb-12">
      <h2 class="text-section mb-4">{expertise.h2}</h2>
      <p class="text-text-secondary leading-relaxed">{expertise.intro}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-12 mb-12">
      {expertise.items.map((item, i) => (
        <div class="reveal">
          <Icon name={icons[i]} class="icon-mark w-6 h-6 mb-5" />
          <h3 class="text-base font-semibold mb-2 tracking-tight">{item.h3}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>

    <p class="text-sm text-text-secondary italic max-w-measure mb-14">{expertise.note}</p>

    {showFounder && (
      flags.showFounderBio ? (
        <div class="flex flex-col sm:flex-row items-start gap-6 border-t border-border-subtle pt-10">
          <img
            src={expertise.founder.photo}
            alt={`Portrait de ${expertise.founder.name}, fondateur de GFlux`}
            width="96"
            height="96"
            loading="lazy"
            class="w-24 h-24 rounded-full object-cover flex-shrink-0"
          />
          <div>
            <p class="font-semibold text-text-primary">{expertise.founder.name}</p>
            <p class="text-sm text-text-secondary mb-3">{expertise.founder.role}</p>
            <p class="text-text-secondary leading-relaxed mb-2">{expertise.founder.bio}</p>
            <p class="text-sm text-text-secondary mb-3">{expertise.founder.expertise}</p>
            <a href={expertise.founder.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-accent">
              Profil LinkedIn
            </a>
          </div>
        </div>
      ) : (
        <div class="placeholder-block border-t-0" style="min-height: 140px;">
          Emplacement du profil fondateur : photo, nom, biographie et expertises validées à venir.
        </div>
      )
    )}
  </div>
</section>
