---
import Icon from "../icons/Icon.astro";
import { solution, flags } from "../../config/siteContent";

const showDemo = flags.showDemo || import.meta.env.DEV;
---

<section id="solution" class="section-padding">
  <div class="container-page">
    <div class="max-w-measure mb-12">
      <h2 class="text-section mb-4">{solution.h2}</h2>
      <p class="text-text-secondary leading-relaxed">{solution.intro}</p>
    </div>

    <div class="mb-14">
      <h3 class="text-lg font-semibold mb-2">{solution.whatH3}</h3>
      <p class="text-sm text-text-secondary italic mb-6">{solution.whatCaveat}</p>
      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
        {solution.whatItems.map((item) => (
          <li class="flex items-start gap-3">
            <Icon name="check" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
            <span class="text-text-primary leading-snug">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-14">
      <div class="bg-bg-secondary border border-border-subtle rounded-lg-soft p-6 md:p-8">
        <h3 class="text-lg font-semibold mb-3">{solution.notH3}</h3>
        <p class="text-text-secondary leading-relaxed">{solution.notText}</p>
      </div>
      <div class="bg-ink-light rounded-lg-soft p-6 md:p-8">
        <h3 class="text-lg font-semibold mb-3">{solution.resultH3}</h3>
        <p class="text-text-primary leading-relaxed">{solution.resultText}</p>
      </div>
    </div>

    {showDemo && (
      <div class="max-w-3xl">
        <h3 class="text-lg font-semibold mb-4">{solution.demo.title}</h3>
        {flags.showDemo ? (
          <video
            class="w-full aspect-video rounded-lg-soft bg-text-primary"
            controls
            preload="none"
            poster={solution.demo.poster}
          >
            <source src={solution.demo.videoUrl} />
          </video>
        ) : (
          <div class="placeholder-block aspect-video">
            Emplacement vidéo de démonstration (16:9) — poster : {solution.demo.poster}, vidéo : {solution.demo.videoUrl}
          </div>
        )}
        <p class="text-sm text-text-secondary leading-relaxed mt-3">{solution.demo.caption}</p>
        <details class="mt-3">
          <summary class="text-sm font-medium text-accent cursor-pointer">Lire la transcription</summary>
          <p class="text-sm text-text-secondary leading-relaxed mt-2">{solution.demo.transcript}</p>
        </details>
      </div>
    )}
  </div>
</section>
