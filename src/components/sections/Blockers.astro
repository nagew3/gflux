---
import Icon from "../icons/Icon.astro";
import { blockers } from "../../config/siteContent";

const icons = ["link-broken", "repeat", "alert", "lock"] as const;
---

<section id="blocages" class="section-padding bg-bg-secondary">
  <div class="container-page">
    <h2 class="text-section mb-12 max-w-measure">{blockers.h2}</h2>

    <div class="border-t border-border-subtle divide-y divide-border-subtle">
      {blockers.items.map((item, i) => (
        <div class="reveal py-8 flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-10">
          <Icon name={icons[i]} class="icon-mark w-6 h-6 flex-shrink-0" />
          <div class="sm:max-w-lg">
            <h3 class="text-base font-semibold mb-1.5 tracking-tight">{item.h3}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{item.text}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 text-text-secondary leading-relaxed max-w-measure font-medium">
      {blockers.conclusion}
    </p>
  </div>
</section>
