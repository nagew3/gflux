---
import Quote from "../Quote.astro";
import ToolsGap from "../visuals/ToolsGap.astro";
import { blockers } from "../../config/siteContent";
---

<section id="blocages" class="section-padding">
  <div class="container-page">
    <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.2fr)] gap-12 lg:gap-24">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker">02 · Blocages</p>
        <h2 class="text-section mb-5">{blockers.h2}</h2>
        <p class="text-text-secondary leading-relaxed mb-10">{blockers.intro}</p>
        <ToolsGap />
      </div>

      <div>
        <div class="border-t border-border-subtle divide-y divide-border-subtle">
          {blockers.items.map((item, i) => (
            <div class="reveal py-9 flex items-start gap-6 sm:gap-9">
              <p class="numeral text-4xl md:text-5xl flex-shrink-0 w-12 md:w-16">{i + 1}</p>
              <div>
                <h3 class="text-lg font-semibold mb-2 tracking-tight">{item.h3}</h3>
                <p class="text-[15px] text-text-secondary leading-relaxed">{item.text}</p>
                {item.quote && <Quote {...item.quote} class="mt-6" />}
              </div>
            </div>
          ))}
        </div>

        <div class="reveal bezel-shell mt-6">
          <p class="bezel-core p-7 md:p-9 text-lg md:text-xl text-text-primary font-medium leading-snug tracking-tight">
            {blockers.conclusion}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
