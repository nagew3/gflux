---
import { method } from "../../config/siteContent";
---

<section id="methode" class="section-padding">
  <div class="container-page">
    <h2 class="text-section mb-12 max-w-measure">{method.h2}</h2>

    <ol class="grid md:grid-cols-5 gap-8 md:gap-4">
      {method.steps.map((step, i) => (
        <li class="reveal relative">
          <div class="flex md:flex-col items-start gap-4 md:gap-3">
            <span class="flex-shrink-0 w-9 h-9 rounded-full border border-accent/40 text-accent flex items-center justify-center font-semibold text-sm">
              {i + 1}
            </span>
            <div>
              <h3 class="text-base font-semibold mb-1.5 tracking-tight">{step.h3}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{step.text}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <p class="mt-12 pt-8 border-t border-border-subtle text-sm text-text-secondary max-w-measure">
      {method.delayNote}
    </p>
  </div>
</section>
