---
import Icon from "../icons/Icon.astro";
import HeroMock from "../visuals/HeroMock.astro";
import { hero, CTA_LABEL, URL_CALENDLY_AUDIT } from "../../config/siteContent";

const icons = ["layers", "shield-check", "lock"] as const;
---

<section id="accueil" class="pt-28 pb-16 md:pt-40 md:pb-28">
  <div class="container-page">
    <div class="grid lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.85fr)] gap-12 lg:gap-16 items-center">
      <div>
        <p class="eyebrow mb-5 sm:mb-7">{hero.eyebrow}</p>
        <h1 class="text-hero tracking-tight mb-6 sm:mb-7">{hero.h1}</h1>
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-8 sm:mb-10 max-w-measure">{hero.subtitle}</p>

        <div class="flex flex-col items-start gap-4">
          <a href={URL_CALENDLY_AUDIT} target="_blank" rel="noopener noreferrer" class="btn-primary w-full sm:w-auto text-base">
            {CTA_LABEL}
          </a>
          <p class="text-base font-medium text-text-primary">{hero.ctaMicrocopy}</p>
        </div>
      </div>

      <div class="reveal">
        <HeroMock />
      </div>
    </div>

    <ul class="grid md:grid-cols-3 gap-x-10 mt-14 md:mt-20 border-t border-border-subtle">
      {hero.markers.map((marker, i) => (
        <li class={`flex items-center gap-4 py-5 md:py-7 ${i > 0 ? "border-t md:border-t-0 border-border-subtle" : ""}`}>
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-accent-light text-accent flex items-center justify-center">
            <Icon name={icons[i]} class="w-[18px] h-[18px]" />
          </span>
          <span class="text-[15px] font-medium text-text-primary leading-snug">{marker}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
