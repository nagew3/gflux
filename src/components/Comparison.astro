---
// components/Comparison.astro
---

<section class="py-24 bg-surface relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <h2 class="font-display text-section text-deep-tech mb-6">
        Pourquoi GFlux n'est pas comparable
      </h2>
      <p class="text-lg text-text-secondary">
        Analysez les alternatives. Seul un système hybride sur mesure répond aux vraies contraintes d'une ESN.
      </p>
    </div>

    <div class="overflow-x-auto pb-8 reveal">
      <div class="min-w-[800px] bg-white rounded-3xl shadow-card border border-gray-100 overflow-hidden">
        
        <!-- Table Header -->
        <div class="grid grid-cols-5 text-sm font-bold text-gray-400 uppercase tracking-wide bg-gray-50 border-b border-gray-100 p-6">
          <div class="col-span-2"></div>
          <div class="text-center px-4">Outils SaaS Génériques</div>
          <div class="text-center px-4">Assistante Classique</div>
          <div class="text-center px-4 text-brand-orange text-base">GFlux (Système IA)</div>
        </div>

        <!-- Row 1 -->
        <div class="grid grid-cols-5 border-b border-gray-50 hover:bg-gray-50 transition-colors">
          <div class="col-span-2 p-6 font-semibold text-deep-tech flex items-center">Disponibilité</div>
          <div class="p-6 text-center text-text-secondary flex items-center justify-center">24/7</div>
          <div class="p-6 text-center text-text-secondary flex items-center justify-center">35h / Semaine</div>
          <div class="p-6 text-center text-deep-tech font-bold bg-brand-orange/5 flex items-center justify-center">24/7</div>
        </div>

        <!-- Row 2 -->
        <div class="grid grid-cols-5 border-b border-gray-50 hover:bg-gray-50 transition-colors">
          <div class="col-span-2 p-6 font-semibold text-deep-tech flex items-center">Adaptation à VOS outils</div>
          <div class="p-6 text-center text-red-500 font-bold flex items-center justify-center">Non (Changement forcé)</div>
          <div class="p-6 text-center text-green-500 font-bold flex items-center justify-center">Oui</div>
          <div class="p-6 text-center text-green-600 font-bold bg-brand-orange/5 flex items-center justify-center">Oui (Intégration API)</div>
        </div>

        <!-- Row 3 -->
        <div class="grid grid-cols-5 border-b border-gray-50 hover:bg-gray-50 transition-colors">
          <div class="col-span-2 p-6 font-semibold text-deep-tech flex items-center">Vitesse de traitement</div>
          <div class="p-6 text-center text-text-secondary flex items-center justify-center">Instantanée</div>
          <div class="p-6 text-center text-text-secondary flex items-center justify-center">Variable</div>
          <div class="p-6 text-center text-deep-tech font-bold bg-brand-orange/5 flex items-center justify-center">Instantanée</div>
        </div>

        <!-- Row 4 -->
        <div class="grid grid-cols-5 border-b border-gray-50 hover:bg-gray-50 transition-colors">
          <div class="col-span-2 p-6 font-semibold text-deep-tech flex items-center">Supervision Humaine / Garde Fou</div>
          <div class="p-6 text-center text-red-500 font-bold flex items-center justify-center">Non (Boîte noire)</div>
          <div class="p-6 text-center text-green-500 font-bold flex items-center justify-center">Oui</div>
          <div class="p-6 text-center text-green-600 font-bold bg-brand-orange/5 flex items-center justify-center">Oui (Validation par vous)</div>
        </div>

        <!-- Row 5 -->
        <div class="grid grid-cols-5 hover:bg-gray-50 transition-colors">
          <div class="col-span-2 p-6 font-semibold text-deep-tech flex items-center">Coût (ROI)</div>
          <div class="p-6 text-center text-text-secondary flex items-center justify-center">Abonnements mensuels cachés</div>
          <div class="p-6 text-center text-text-secondary flex items-center justify-center">Salaire + Charges fixes (Lourd)</div>
          <div class="p-6 text-center text-brand-orange font-bold bg-brand-orange/10 flex items-center justify-center text-lg">Investissement amorti en 2 mois</div>
        </div>

      </div>
    </div>

  </div>
</section>
