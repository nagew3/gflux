---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Mentions légales | GFlux" description="Mentions légales du site GFlux.">
  <header class="border-b border-border-subtle">
    <div class="container-page flex items-center h-[64px]">
      <a href="/" aria-label="GFlux, retour à l'accueil">
        <Logo />
      </a>
    </div>
  </header>

  <main id="contenu">
    <section class="section-padding">
      <div class="container-page max-w-2xl">
        <h1 class="text-section mb-8">Mentions légales</h1>

        <div class="space-y-6 text-text-secondary leading-relaxed">
          <p>Le présent site est édité par GFlux.</p>

          <dl class="space-y-3">
            <div><dt class="font-medium text-text-primary inline">Raison sociale : </dt><dd class="inline">GFlux, entreprise individuelle</dd></div>
            <div><dt class="font-medium text-text-primary inline">Forme juridique : </dt><dd class="inline">Entreprise individuelle</dd></div>
            <div><dt class="font-medium text-text-primary inline">Capital social : </dt><dd class="inline">Non applicable (entreprise individuelle)</dd></div>
            <div><dt class="font-medium text-text-primary inline">SIREN : </dt><dd class="inline">980 655 567</dd></div>
            <div><dt class="font-medium text-text-primary inline">SIRET : </dt><dd class="inline">980 655 567 00033</dd></div>
            <div><dt class="font-medium text-text-primary inline">RCS : </dt><dd class="inline">Non applicable (entreprise individuelle)</dd></div>
            <div><dt class="font-medium text-text-primary inline">Numéro de TVA intracommunautaire : </dt><dd class="inline">Non applicable (franchise en base de TVA)</dd></div>
            <div><dt class="font-medium text-text-primary inline">Siège social : </dt><dd class="inline">Non communiquée</dd></div>
            <div><dt class="font-medium text-text-primary inline">Directeur de la publication : </dt><dd class="inline">Gawen François</dd></div>
            <div><dt class="font-medium text-text-primary inline">Hébergeur du site : </dt><dd class="inline">OVH SAS</dd></div>
            <div><dt class="font-medium text-text-primary inline">Adresse de l'hébergeur : </dt><dd class="inline">2 rue Kellermann, 59100 Roubaix, France</dd></div>
            <div><dt class="font-medium text-text-primary inline">Contact : </dt><dd class="inline">gawen.francois@gflux.fr</dd></div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
