---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProblemQualification from '../components/ProblemQualification.astro';
import StoryOrigin from '../components/StoryOrigin.astro';
import UnderlyingBlockers from '../components/UnderlyingBlockers.astro';
import Solution from '../components/Solution.astro';
import ValueProposition from '../components/ValueProposition.astro';
import Methodology from '../components/Methodology.astro';
import Offers from '../components/Offers.astro';
import Proofs from '../components/Proofs.astro';
import Benefits from '../components/Benefits.astro';
import Comparison from '../components/Comparison.astro';
import CentralCTA from '../components/CentralCTA.astro';
import FAQ from '../components/FAQ.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="GFlux — Récupérez 5 à 10h par semaine sans changer vos outils">
  <Navbar />
  
  <main>
    <!-- 1. HERO SECTION ABOVE THE FOLD -->
    <Hero />
    
    <!-- 2. SECTION PROBLÈME / QUALIFICATION -->
    <ProblemQualification />
    
    <!-- 3. SECTION STORY / ORIGINE -->
    <StoryOrigin />
    
    <!-- 4. SECTION PROBLÈME DE FOND / BLOCAGES -->
    <UnderlyingBlockers />
    
    <!-- 5. SECTION SOLUTION -->
    <Solution />
    
    <!-- 6. SECTION PROPOSITION DE VALEUR / EXPERTISE -->
    <ValueProposition />
    
    <!-- 7. SECTION PROCESS / MÉTHODOLOGIE -->
    <Methodology />
    
    <!-- 8. SECTION OFFRES / NIVEAUX D'ACCOMPAGNEMENT -->
    <Offers />
    
    <!-- 9. SECTION PREUVES & CRÉDIBILITÉ -->
    <Proofs />
    
    <!-- 10. SECTION BÉNÉFICES CONCRETS -->
    <Benefits />
    
    <!-- 11. SECTION DIFFÉRENCIATION / COMPARATIF -->
    <Comparison />
    
    <!-- 12. CALL TO CTA CENTRAL -->
    <CentralCTA />
    
    <!-- 13. FAQ -->
    <FAQ />
    
    <!-- 14. SECTION CLOSING -->
    <Closing />
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // General Reveal elements
  const revealElements = document.querySelectorAll('.reveal');
  revealElements.forEach((el) => {
    gsap.fromTo(el,
      { autoAlpha: 0, y: 40 },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.5,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 95%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>
